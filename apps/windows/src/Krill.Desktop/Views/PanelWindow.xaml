<Window x:Class="Krill.Desktop.Views.PanelWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:Krill.Desktop.Controls"
        Title="Krill Desktop" Width="520" Height="800" MinWidth="430" MinHeight="500" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="{Binding AlwaysOnTop}" Style="{StaticResource {x:Type Window}}" Icon="/Assets/krill.ico" PreviewKeyDown="PanelKeyDown" Deactivated="PanelDeactivated">
    <Border Margin="10" Background="{StaticResource BackgroundBrush}" BorderBrush="#344750" BorderThickness="1" CornerRadius="22">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="76" /><RowDefinition Height="44" /><RowDefinition Height="*" /><RowDefinition Height="68" /></Grid.RowDefinitions>
            <Grid Margin="24,0,18,0" MouseLeftButtonDown="HeaderMouseDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="11" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left">
                    <TextBlock Text="k" Foreground="#123B34" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-5,0,0" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="krill" FontSize="23" FontWeight="SemiBold" Margin="0,-3,0,0" />
                    <TextBlock Text="D E S K T O P" FontSize="9" Foreground="{StaticResource SubtleBrush}" Margin="1,0,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="↻" Style="{StaticResource IconButton}" Command="{Binding RefreshCommand}" ToolTip="立即刷新" AutomationProperties.Name="立即刷新" />
                    <Button Content="⌖" Click="PinClick" ToolTip="固定 / 取消固定面板" AutomationProperties.Name="固定面板">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource IconButton}"><Style.Triggers>
                            <DataTrigger Binding="{Binding PanelPinned}" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /><Setter Property="Background" Value="#203A3B" /></DataTrigger>
                        </Style.Triggers></Style></Button.Style>
                    </Button>
                    <Button Content="×" Style="{StaticResource IconButton}" Click="HideClick" ToolTip="收起面板" AutomationProperties.Name="收起面板" />
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Background="#132028" CornerRadius="12" Margin="24,0,24,4" Padding="3">
                <UniformGrid Columns="5">
                    <RadioButton Content="概览" GroupName="Nav" Style="{StaticResource NavTab}" IsChecked="{Binding SelectedTab, Converter={StaticResource TabChecked}, ConverterParameter=0}" />
                    <RadioButton Content="套餐" GroupName="Nav" Style="{StaticResource NavTab}" IsChecked="{Binding SelectedTab, Converter={StaticResource TabChecked}, ConverterParameter=1}" />
                    <RadioButton Content="用量" GroupName="Nav" Style="{StaticResource NavTab}" IsChecked="{Binding SelectedTab, Converter={StaticResource TabChecked}, ConverterParameter=2}" />
                    <RadioButton Content="公告" GroupName="Nav" Style="{StaticResource NavTab}" IsChecked="{Binding SelectedTab, Converter={StaticResource TabChecked}, ConverterParameter=3}" />
                    <RadioButton Content="设置" GroupName="Nav" Style="{StaticResource NavTab}" IsChecked="{Binding SelectedTab, Converter={StaticResource TabChecked}, ConverterParameter=4}" />
                </UniformGrid>
            </Border>
            <Grid Grid.Row="2" Margin="24,14,19,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Margin="0,0,5,0">
                    <Border Background="#302D26" BorderBrush="#61513A" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,12" Visibility="{Binding IsDemo, Converter={StaticResource BoolVisibility}}">
                        <DockPanel><TextBlock Text="演示数据" Foreground="{StaticResource AmberBrush}" FontWeight="SemiBold" Margin="0,0,12,0" /><TextBlock Text="虚构样例，不代表真实账号" Foreground="#C4B69D" FontSize="12" /></DockPanel>
                    </Border>
                    <Border Background="#302822" BorderBrush="#5A4232" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12" Visibility="{Binding IsStale, Converter={StaticResource BoolVisibility}}">
                        <StackPanel><TextBlock Text="{Binding StatusDetail}" TextWrapping="Wrap" FontSize="12" Foreground="#E5C09D" />
                            <Button Content="重新连接" Command="{Binding LoginCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="{Binding NeedsLogin, Converter={StaticResource BoolVisibility}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,5,12" Visibility="{Binding ShowWelcome, Converter={StaticResource BoolVisibility}}">
                    <StackPanel Margin="8,18,8,0">
                        <Grid Width="132" Height="132" HorizontalAlignment="Left" Margin="0,0,0,27">
                            <Ellipse Fill="#193137" /><c:QuotaRing Value="72" Stroke="#7CE3CD" Thickness="3" Margin="11" />
                            <TextBlock Text="k" FontSize="69" FontWeight="SemiBold" Foreground="#7CE3CD" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-12,0,0" />
                            <Border Background="#233B40" BorderBrush="#3C5D60" BorderThickness="1" CornerRadius="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-15,3" Padding="10,5"><TextBlock Text="随时掌握" FontSize="11" Foreground="#A4E7D9" /></Border>
                        </Grid>
                        <TextBlock Text="用量与余额，&#10;一眼就知道。" FontSize="32" FontWeight="SemiBold" LineHeight="45" />
                        <TextBlock Text="把 Krill 放在桌面一角。&#10;套餐剩余、账户余额和最新公告，随手可见。" Foreground="{StaticResource MutedBrush}" FontSize="13" LineHeight="23" Margin="0,16,0,26" />
                        <Button Content="使用 GitHub 连接" Style="{StaticResource AccentButton}" Height="44" Command="{Binding LoginCommand}" AutomationProperties.Name="使用 GitHub 连接" />
                        <Button Content="先看演示  →" Style="{StaticResource GhostButton}" Command="{Binding ShowDemoCommand}" Margin="0,8,0,14" />
                        <TextBlock Text="登录会话在本机加密保存" HorizontalAlignment="Center" Foreground="{StaticResource SubtleBrush}" FontSize="11" />
                    </StackPanel>
                </ScrollViewer>
                <Grid Grid.Row="1" Visibility="{Binding HasData, Converter={StaticResource BoolVisibility}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,5,12" Visibility="{Binding SelectedTab, Converter={StaticResource TabVisibility}, ConverterParameter=0}">
                        <StackPanel>
                            <Grid Margin="0,2,0,18">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Background="#253C44" Width="32" Height="32" CornerRadius="11" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding AvatarText}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#A5D9D1" FontWeight="SemiBold" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding UserName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding UserEmail}" Style="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="账户 ↗" Style="{StaticResource GhostButton}" Command="{Binding OpenWebsiteCommand}" CommandParameter="/app/account" FontSize="11" Padding="7,5" />
                            </Grid>
                            <Border CornerRadius="18" BorderBrush="#35534F" BorderThickness="1" Padding="20,19" Margin="0,0,0,12">
                                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1D3838" /><GradientStop Color="#172930" Offset="1" /></LinearGradientBrush></Border.Background>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="104" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding PrimaryCycle}" FontSize="12" Foreground="#A7C9C2" />
                                        <TextBlock Text="{Binding PrimaryRemaining}" FontSize="37" FontWeight="SemiBold" Foreground="#A3F1DC" Margin="-2,8,0,3" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding PrimaryPlanName}" FontSize="12" Foreground="#CCDDDA" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding PrimaryReset}" FontSize="10" Foreground="#89A9A6" Margin="0,13,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" Width="98" Height="98" VerticalAlignment="Center">
                                        <c:QuotaRing Value="{Binding QuotaPercent}" Stroke="{Binding AccentColor}" Thickness="5" />
                                        <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding QuotaPercentText}" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#B7F4E5" /><TextBlock Text="周期剩余" FontSize="10" Foreground="#8EB8AF" HorizontalAlignment="Center" Margin="0,2,0,0" /></StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}" Padding="17,14"><StackPanel><TextBlock Text="充值余额 / USD" Style="{StaticResource SectionLabel}" /><TextBlock Text="{Binding CreditText}" FontSize="25" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel></Border>
                                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="17,14"><StackPanel><TextBlock Text="福利余额 / USD" Style="{StaticResource SectionLabel}" /><TextBlock Text="{Binding WelfareText}" FontSize="25" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel></Border>
                            </Grid>
                            <Grid Margin="1,0,1,10"><TextBlock Text="最新公告" FontWeight="SemiBold" /><TextBlock Text="{Binding UnreadText}" Foreground="{StaticResource SubtleBrush}" FontSize="11" HorizontalAlignment="Right" /></Grid>
                            <ItemsControl ItemsSource="{Binding RecentAnnouncements}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Button Command="{Binding DataContext.OpenAnnouncementCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0,0,0,1" HorizontalContentAlignment="Stretch" Padding="0,11">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="17" /></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Date}" FontSize="10" Foreground="{StaticResource SubtleBrush}" Margin="0,4,0,0" /></StackPanel>
                                            <TextBlock Grid.Column="1" Text="↗" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding PlanCountText}" Style="{StaticResource Muted}" FontSize="10" Margin="0,13,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,5,12" Visibility="{Binding SelectedTab, Converter={StaticResource TabVisibility}, ConverterParameter=1}">
                        <StackPanel>
                            <DockPanel Margin="0,4,0,6"><Button Content="前往选购 ↗" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding OpenWebsiteCommand}" CommandParameter="/app/shop" FontSize="11" /><TextBlock Text="我的套餐" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
                            <TextBlock Text="{Binding PlanCountText}" Style="{StaticResource Muted}" Margin="0,0,0,20" />
                            <TextBlock Text="悬浮球显示的套餐" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                            <ComboBox ItemsSource="{Binding SelectablePlans}" SelectedItem="{Binding SelectedPlan}" DisplayMemberPath="Name" Margin="0,0,0,18" AutomationProperties.Name="悬浮球显示的套餐" />
                            <ItemsControl ItemsSource="{Binding Plans}"><ItemsControl.ItemTemplate><DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,12,0" />
                                            <Border Grid.Column="1" Background="#213B39" CornerRadius="6" Padding="8,4" VerticalAlignment="Top"><TextBlock Text="{Binding State}" FontSize="10" Foreground="#9CD6C7" /></Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Cycle}" Style="{StaticResource Muted}" Margin="0,15,0,5" />
                                        <DockPanel><TextBlock Text="{Binding Limit, StringFormat=上限 {0}}" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" FontSize="11" /><TextBlock Text="{Binding Remaining}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" /></DockPanel>
                                        <ProgressBar Style="{StaticResource QuotaBar}" Value="{Binding Percent, Mode=OneWay}" Margin="0,12,0,12" />
                                        <TextBlock Text="{Binding Used, StringFormat=已用 {0}}" Style="{StaticResource Muted}" />
                                        <TextBlock Text="{Binding Forwarded, StringFormat=另有结转 {0}}" Foreground="#A9C7D6" FontSize="11" Margin="0,5,0,0" Visibility="{Binding HasForwarded, Converter={StaticResource BoolVisibility}}" />
                                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14,0,11" />
                                        <Grid><TextBlock Text="{Binding Reset}" FontSize="10" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding Expiry}" FontSize="10" Foreground="{StaticResource SubtleBrush}" HorizontalAlignment="Right" /></Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <TextBlock Text="金额单位为 USD。结转额度单独显示；套餐变更、续费与支付请前往官网。" TextWrapping="Wrap" Style="{StaticResource Muted}" FontSize="11" LineHeight="19" />
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,5,12" Visibility="{Binding SelectedTab, Converter={StaticResource TabVisibility}, ConverterParameter=2}">
                        <StackPanel>
                            <TextBlock Text="今日用量" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,7" />
                            <TextBlock Text="{Binding StatsNote}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,20" />
                            <UniformGrid Columns="3" Margin="-4,0,-4,16">
                                <Border Style="{StaticResource Card}" Margin="4,0" Padding="13,16"><StackPanel><TextBlock Text="请求数" Style="{StaticResource SectionLabel}" /><TextBlock Text="{Binding RequestsText}" FontSize="23" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" /></StackPanel></Border>
                                <Border Style="{StaticResource Card}" Margin="4,0" Padding="13,16"><StackPanel><TextBlock Text="Tokens" Style="{StaticResource SectionLabel}" /><TextBlock Text="{Binding TokensText}" FontSize="23" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" /></StackPanel></Border>
                                <Border Style="{StaticResource Card}" Margin="4,0" Padding="13,16"><StackPanel><TextBlock Text="费用 / USD" Style="{StaticResource SectionLabel}" /><TextBlock Text="{Binding CostText}" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" /></StackPanel></Border>
                            </UniformGrid>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel><TextBlock Text="时段费用" FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{Binding ChartBars}" Height="104" Margin="0,16,0,8" VerticalAlignment="Bottom">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate><Border Background="#7CE3CD" Opacity="0.8" CornerRadius="2,2,0,0" Height="{Binding Height}" VerticalAlignment="Bottom" Margin="2,0" ToolTip="{Binding Tooltip}" /></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="悬停柱形查看对应时段费用与请求数" Foreground="{StaticResource SubtleBrush}" FontSize="10" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <Grid Margin="0,0,0,15"><TextBlock Text="请求成功率" Style="{StaticResource Muted}" /><TextBlock Text="{Binding SuccessRateText}" HorizontalAlignment="Right" /></Grid>
                                <Grid Margin="0,0,0,15"><TextBlock Text="输入 Tokens" Style="{StaticResource Muted}" /><TextBlock Text="{Binding InputTokensText}" HorizontalAlignment="Right" /></Grid>
                                <Grid><TextBlock Text="输出 Tokens" Style="{StaticResource Muted}" /><TextBlock Text="{Binding OutputTokensText}" HorizontalAlignment="Right" /></Grid>
                            </StackPanel></Border>
                            <Button Content="在官网查看完整用量记录 ↗" Command="{Binding OpenWebsiteCommand}" CommandParameter="/app/logs" Style="{StaticResource GhostButton}" Margin="0,14,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,5,12" Visibility="{Binding SelectedTab, Converter={StaticResource TabVisibility}, ConverterParameter=3}">
                        <StackPanel>
                            <DockPanel Margin="0,4,0,7"><TextBlock Text="{Binding UnreadText}" DockPanel.Dock="Right" Foreground="{StaticResource AccentBrush}" FontSize="11" VerticalAlignment="Center" /><TextBlock Text="公告与动态" FontSize="22" FontWeight="SemiBold" /></DockPanel>
                            <TextBlock Text="{Binding AnnouncementNote}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,20" />
                            <ItemsControl ItemsSource="{Binding Announcements}"><ItemsControl.ItemTemplate><DataTemplate>
                                <Button Command="{Binding DataContext.OpenAnnouncementCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" Padding="17" Margin="0,0,0,12" HorizontalContentAlignment="Stretch">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10"><TextBlock Text="↗" DockPanel.Dock="Right" Foreground="{StaticResource SubtleBrush}" /><TextBlock Text="{Binding Date}" FontSize="10" Foreground="{StaticResource SubtleBrush}" /><TextBlock Text="  •  未读" Foreground="{StaticResource AccentBrush}" FontSize="10" Visibility="{Binding IsUnread, Converter={StaticResource BoolVisibility}}" /></DockPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="22" />
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="21" Margin="0,9,0,0" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,5,12" Visibility="{Binding SelectedTab, Converter={StaticResource TabVisibility}, ConverterParameter=4}">
                    <StackPanel>
                        <TextBlock Text="按你的习惯来" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,7" />
                        <TextBlock Text="设置自动保存，仅作用于当前设备。" Style="{StaticResource Muted}" Margin="0,0,0,20" />
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel>
                            <TextBlock Text="桌面行为" Style="{StaticResource SectionLabel}" Margin="0,0,0,20" />
                            <CheckBox Content="悬浮球和面板保持置顶" IsChecked="{Binding AlwaysOnTop}" Margin="0,0,0,21" />
                            <CheckBox Content="贴边后自动收为进度竖条" IsChecked="{Binding SnapToEdge}" Margin="0,0,0,21" />
                            <CheckBox Content="固定面板，点击其他窗口时不收起" IsChecked="{Binding PanelPinned}" Margin="0,0,0,21" />
                            <CheckBox Content="登录 Windows 后自动启动" IsChecked="{Binding StartWithWindows}" />
                        </StackPanel></Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14"><Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="后台刷新间隔" FontWeight="SemiBold" /><TextBlock Text="单位：秒 · 展开面板时加快刷新" Style="{StaticResource Muted}" FontSize="10" Margin="0,5,0,0" /></StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding RefreshIntervals}" SelectedItem="{Binding RefreshSeconds}" AutomationProperties.Name="后台刷新间隔（秒）" />
                        </Grid></Border>
                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock Text="账号与连接" FontWeight="SemiBold" />
                            <TextBlock Text="登录会话在本机加密保存。退出账号将清除本机凭据；官网中的登录状态独立保留。" Style="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="21" Margin="0,10,0,14" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="连接账号" Command="{Binding LoginCommand}" Style="{StaticResource AccentButton}" Margin="0,0,10,0" />
                                <Button Content="退出账号" Command="{Binding SignOutCommand}" Visibility="{Binding NeedsLogin, Converter={StaticResource InverseVisibility}}" />
                            </StackPanel>
                        </StackPanel></Border>
                        <DockPanel Margin="0,19,0,0"><Button Content="退出程序" DockPanel.Dock="Right" Command="{Binding ExitCommand}" Style="{StaticResource GhostButton}" Foreground="#DCACA5" FontSize="11" /><StackPanel VerticalAlignment="Center"><TextBlock Text="KRILL DESKTOP  /  0.1.1" FontSize="10" Foreground="{StaticResource SubtleBrush}" /><TextBlock Text="个人桌面客户端" FontSize="10" Foreground="{StaticResource SubtleBrush}" Margin="0,3,0,0" /></StackPanel></DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Border Grid.Row="3" BorderBrush="#24343D" BorderThickness="0,1,0,0" Margin="24,0" Padding="0,13,0,12">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" ToolTip="{Binding StatusDetail}"><DockPanel><Ellipse Width="5" Height="5" Fill="{Binding AccentColor}" Margin="0,0,6,0" /><TextBlock Text="{Binding StatusTitle}" FontSize="11" /></DockPanel><TextBlock Text="{Binding LastUpdatedText}" Foreground="{StaticResource SubtleBrush}" FontSize="10" Margin="11,4,0,0" /></StackPanel>
                    <Button Grid.Column="1" Content="打开官网  ↗" Command="{Binding OpenWebsiteCommand}" CommandParameter="/app" Background="#253D40" BorderBrush="#355755" Foreground="#ADE9DA" Padding="15,8" FontSize="12" />
                </Grid>
            </Border>
            <ProgressBar Grid.Row="0" Height="2" VerticalAlignment="Bottom" Margin="24,0" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}" Background="Transparent" Visibility="{Binding IsLoading, Converter={StaticResource BoolVisibility}}" />
        </Grid>
    </Border>
</Window>
