<Window x:Class="Krill.Desktop.Views.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="连接 Krill 账号" Width="960" Height="760" MinWidth="720" MinHeight="620"
        WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}" Background="{StaticResource BackgroundBrush}" Icon="/Assets/krill.ico">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Background="#172A30" Padding="20,15"><DockPanel>
            <Button x:Name="ModeButton" Content="改用应用内登录" Click="ToggleModeClick" DockPanel.Dock="Right" Margin="16,0,0,0" />
            <StackPanel>
                <TextBlock Text="连接 Krill 账号" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="支持官网任意登录方式及 Apple、GitHub 等第三方授权。" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0" />
            </StackPanel>
        </DockPanel></Border>
        <ScrollViewer x:Name="BrowserGuide" Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="28" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="使用默认浏览器的已有登录状态" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
            <Button Content="在浏览器中登录 ↗" Click="OpenBrowserClick" HorizontalAlignment="Left" Style="{StaticResource AccentButton}" Margin="0,0,0,24" />
            <TextBlock Text="1. 在浏览器中完成 Krill 登录；已登录可直接使用。&#10;2. 在 Krill 官网打开开发者工具的“控制台”，粘贴并运行下方按钮复制的脚本。&#10;3. 复制弹出的会话，粘贴到下面并连接。" TextWrapping="Wrap" LineHeight="28" />
            <TextBlock Text="官网目前不支持自动回传桌面端，因此需要手动导入一次。会话等同于登录凭据，请勿分享。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,20" />
            <Button Content="复制会话导出脚本" Click="CopyExportScriptClick" HorizontalAlignment="Left" Margin="0,0,0,20" />
            <TextBlock Text="Krill 会话" Margin="0,0,0,8" />
            <DockPanel>
                <Button Content="验证并连接" Click="ImportSessionClick" DockPanel.Dock="Right" Margin="12,0,0,0" />
                <PasswordBox x:Name="SessionInput" MinWidth="340" MaxLength="16400" AutomationProperties.Name="Krill 会话" VerticalContentAlignment="Center" />
            </DockPanel>
        </StackPanel></ScrollViewer>
        <Grid x:Name="EmbeddedContainer" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <TextBlock x:Name="LocationText" Margin="20,10" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}" />
            <wv:WebView2 x:Name="Browser" Grid.Row="1" />
        </Grid>
        <Border Grid.Row="2" Padding="20,12"><DockPanel>
            <Button x:Name="RuntimeButton" Content="获取 WebView2 Runtime ↗" Click="RuntimeClick" DockPanel.Dock="Right" Visibility="Collapsed" Margin="12,0,0,0" />
            <TextBlock x:Name="StatusText" Text="选择浏览器登录，可使用已有登录状态及官网提供的任意登录方式。" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12" />
        </DockPanel></Border>
    </Grid>
</Window>
